# Supabase connection used by server-side code
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# The same public connection exposed to the browser by Vite
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Required only by trusted server-side admin operations; never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=

# Required only for Drizzle migrations
DATABASE_URL=
